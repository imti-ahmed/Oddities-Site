{
  "functions": {
    "api/index.php": { "runtime": "vercel-php@0.9.0", "includeFiles": "{index.php,style.css,assets/app.js,lib/**,config/**,data/**}" },
    "api/icon.php":  { "runtime": "vercel-php@0.9.0", "includeFiles": "assets/icons/**" },
    "api/img.php":   { "runtime": "vercel-php@0.9.0", "includeFiles": "lib/**" }
  },
  "routes": [
    { "src": "/favicon\\.ico", "dest": "/api/icon.php?f=favicon.ico" },
    { "src": "/assets/icons/(favicon\\.ico|favicon-32\\.png|apple-touch-icon\\.png)", "dest": "/api/icon.php?f=$1" },
    { "src": "/api/img\\.php", "dest": "/api/img.php" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
