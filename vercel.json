{
  "functions": {
    "api/index.php": { "runtime": "vercel-php@0.9.0", "includeFiles": "{index.php,style.css,lib/**,config/**,data/**}" },
    "api/admin.php": { "runtime": "vercel-php@0.9.0", "includeFiles": "{admin.php,style.css,lib/**,config/**,data/**}" }
  },
  "routes": [
    { "src": "/admin(\\.php)?", "dest": "/api/admin.php" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
